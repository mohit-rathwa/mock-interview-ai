{
    "version": 2,
    "builds": [
        {
            "src": "Frontend/package.json",
            "use": "@vercel/vite"
        },
        {
            "src": "Backend/server.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/Backend/server.js"
        },
        {
            "source": "/(.*)",
            "destination": "/Frontend/dist/index.html"
        }
    ]
}
